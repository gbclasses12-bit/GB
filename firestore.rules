rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlatform(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.order is number
        && (!('sidebarName' in data) || (data.sidebarName is string && data.sidebarName.size() <= 128))
        && (!('borderColor' in data) || (data.borderColor is string && data.borderColor.size() <= 64))
        && (!('glowColor' in data) || (data.glowColor is string && data.glowColor.size() <= 64))
        && (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 64))
        && (!('url' in data) || (data.url is string && data.url.size() <= 2048))
        && (!('customIcon' in data) || (data.customIcon is string && data.customIcon.size() <= 500000))
        && (!('isCustom' in data) || data.isCustom is bool)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /platforms/{platformId} {
      allow read: if true;
      allow create, update: if isValidId(platformId) && isValidPlatform(request.resource.data);
      allow delete: if isValidId(platformId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
