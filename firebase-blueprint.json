{
  "entities": {
    "Platform": {
      "title": "Platform",
      "description": "Represents an educational study platform",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique platform identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Platform display name",
          "maxLength": 128
        },
        "sidebarName": {
          "type": "string",
          "description": "Short name for the sidebar navigation",
          "maxLength": 128
        },
        "borderColor": {
          "type": "string",
          "description": "Tailwind border class",
          "maxLength": 64
        },
        "glowColor": {
          "type": "string",
          "description": "CSS color value for box-shadow glow",
          "maxLength": 64
        },
        "accentColor": {
          "type": "string",
          "description": "Hex or CSS color string for platform accent",
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "description": "External platform URL if applicable",
          "maxLength": 2048
        },
        "customIcon": {
          "type": "string",
          "description": "Custom image URL or base64 icon data",
          "maxLength": 500000
        },
        "isCustom": {
          "type": "boolean",
          "description": "Whether the platform was created by an admin"
        },
        "order": {
          "type": "number",
          "description": "Sort order index for platform arrangement"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 64
        }
      },
      "required": ["id", "name", "order"]
    }
  },
  "firestore": {
    "/platforms/{platformId}": {
      "schema": "Platform",
      "description": "Collection of all educational platforms synchronized in real time"
    }
  }
}
